{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novi-subtitles",
  "compatibility_date": "2026-11-16",
  "main": "./worker/index.js",
  "upload_source_maps": true,

  // Website (React) files. /api/* ඉල්ලීම් Worker එකට යනවා, අනිත් ඒවා React app එකට.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Database එක. "database_id" එක `npx wrangler d1 create novi-subtitles-db` එකෙන් ලැබෙන ID එකෙන් replace කරන්න.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novi-subtitles-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Videos තියාගන්න තැන (R2). `npx wrangler r2 bucket create novi-subtitles-videos` එකෙන් හදන්න.
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "novi-subtitles-videos" }
  ],

  // Secrets (keys) මෙතන දාන්න එපා! මේ commands වලින් දාන්න:
  //   npx wrangler secret put ELEVENLABS_API_KEY
  //   npx wrangler secret put KEY_ENCRYPTION_SECRET
  // Local එකට: web/.dev.vars file එකේ (.dev.vars.example බලන්න)

  "vars": {
    "APP_NAME": "Novi Subtitles",
    // මේ emails වලින් register වෙන අය auto admin වෙනවා (comma වලින් වෙන් කරන්න)
    // ⚠️ Deploy කරන්න කලින් ඔයාගේ email එක දාන්න. හිස් නම් පළවෙනි user එක admin වෙනවා.
    "ADMIN_EMAILS": "",
    // Password hashing rounds (10000–100000). Cloudflare free plan එකේ login error 1102 ආවොත් 20000 කරන්න.
    "PASSWORD_ITERATIONS": "100000"
  },

  "observability": { "enabled": true }
}
